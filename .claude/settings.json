{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Bash(make:*)",
      "Bash(pnpm:*)",
      "Bash(uv:*)",
      "Bash(pytest:*)",
      "Bash(vitest:*)",
      "Bash(rg:*)",
      "Bash(git:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(diff:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git remote add:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)",
      "Bash(uv tool install:*)",
      "Bash(uvx:*)",
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(brew:*)",
      "Read(./refs/**)",
      "Edit(./refs/**)",
      "Write(./refs/**)",
      "Read(./.env.local)",
      "Read(~/**)",
      "Edit(~/**)",
      "Write(~/**)",
      "Edit(//**)",
      "Write(//**)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
